# ===== Banco de dados =====
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/emprestimoshero?schema=public"

# ===== Servidor =====
PORT=4000
NODE_ENV=development
APP_URL=http://localhost:5173          # URL pública do frontend (usada em links de e-mail/SMS)
API_URL=http://localhost:4000          # URL pública da API (usada em webhooks)
CORS_ORIGINS=http://localhost:5173

# ===== Segurança =====
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
JWT_ACCESS_TTL=15m
JWT_REFRESH_DAYS=30
ENCRYPTION_KEY=                        # 32 bytes em hex (openssl rand -hex 32) - usado para segredos de 2FA
COOKIE_SECURE=false                    # true em produção (HTTPS)

# ===== Armazenamento privado de documentos =====
STORAGE_DRIVER=local                   # local (único driver incluído; S3 previsto na interface)
STORAGE_LOCAL_PATH=./storage

# ===== E-mail (SMTP) =====
# Sem SMTP configurado, as mensagens são registradas no log e no histórico (modo "console").
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Cobranças <no-reply@exemplo.com.br>"

# ===== SMS =====
# Provedor genérico HTTP (compatível com Twilio). Vazio = modo console.
SMS_PROVIDER=console                   # console | twilio
SMS_TWILIO_ACCOUNT_SID=
SMS_TWILIO_AUTH_TOKEN=
SMS_TWILIO_FROM=

# ===== Pagamentos (Pix e boleto) =====
# mock = provedor simulado para demonstração; os webhooks são validados por HMAC com PAYMENTS_WEBHOOK_SECRET.
PAYMENTS_PROVIDER=mock                 # mock | (adaptador real a configurar)
PAYMENTS_WEBHOOK_SECRET=troque-este-segredo
PAYMENTS_API_KEY=

# ===== Assinatura eletrônica =====
SIGNATURE_PROVIDER=mock                # mock | (adaptador real a configurar: Clicksign, D4Sign, ZapSign)
SIGNATURE_WEBHOOK_SECRET=troque-este-segredo
SIGNATURE_API_KEY=

# ===== Backups =====
BACKUP_PATH=./backups
BACKUP_RETENTION_DAYS=30

# ===== Worker de automações =====
WORKER_CRON_COLLECTIONS="*/5 * * * *"
WORKER_CRON_MONTHLY_CLOSE="10 0 * * *"
DEFAULT_TIMEZONE=America/Sao_Paulo
