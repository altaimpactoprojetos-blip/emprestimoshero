// Modelo de dados da plataforma de gestão de empréstimos.
// Todas as tabelas de negócio possuem companyId para garantir o isolamento entre empresas.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// Plataforma (proprietário do software) — financeiro das assinaturas
// ============================================================

enum CompanyStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELLED
}

model Plan {
  id            String   @id @default(cuid())
  name          String
  description   String?
  monthlyPrice  Decimal  @db.Decimal(12, 2)
  maxUsers      Int      @default(5)
  maxClients    Int?
  features      Json     @default("{}")
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  companies     Company[]
  subscriptions Subscription[]
}

model Company {
  id             String        @id @default(cuid())
  slug           String        @unique
  name           String
  legalName      String?
  cnpj           String?
  email          String?
  phone          String?
  address        String?
  logoFileId     String?
  primaryColor   String        @default("#0B2A4A")
  secondaryColor String        @default("#1F6FB2")
  status         CompanyStatus @default(TRIAL)
  planId         String?
  plan           Plan?         @relation(fields: [planId], references: [id])
  timezone       String        @default("America/Sao_Paulo")
  settings       Json          @default("{}")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  users               User[]
  subscriptions       Subscription[]
  subscriptionInvoices SubscriptionInvoice[]
  clients             Client[]
  loans               Loan[]
  installments        Installment[]
  payments            Payment[]
  contracts           Contract[]
  contractTemplates   ContractTemplate[]
  files               StoredFile[]
  auditLogs           AuditLog[]
  rolePermissions     RolePermission[]
  collectionSettings  CollectionSettings?
  messageTemplates    MessageTemplate[]
  reminders           Reminder[]
  charges             Charge[]
  notifications       Notification[]
  monthlyReports      MonthlyReport[]
  expenses            Expense[]
  serviceRequests     ServiceRequest[]
  renegotiations      Renegotiation[]
  loanProducts        LoanProduct[]
  counters            Counter[]
  clientAccessTokens  ClientAccessToken[]
  clientDocuments     ClientDocument[]
  integrationIssues   IntegrationIssue[]
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
}

model Subscription {
  id                 String             @id @default(cuid())
  companyId          String
  company            Company            @relation(fields: [companyId], references: [id])
  planId             String
  plan               Plan               @relation(fields: [planId], references: [id])
  status             SubscriptionStatus @default(TRIAL)
  monthlyPrice       Decimal            @db.Decimal(12, 2)
  maxUsers           Int
  features           Json               @default("{}")
  startedAt          DateTime           @default(now())
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelledAt        DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  invoices           SubscriptionInvoice[]
}

enum InvoiceStatus {
  OPEN
  PAID
  OVERDUE
  CANCELLED
}

model SubscriptionInvoice {
  id             String        @id @default(cuid())
  subscriptionId String
  subscription   Subscription  @relation(fields: [subscriptionId], references: [id])
  companyId      String
  company        Company       @relation(fields: [companyId], references: [id])
  referenceMonth String // AAAA-MM
  amount         Decimal       @db.Decimal(12, 2)
  dueDate        DateTime      @db.Date
  status         InvoiceStatus @default(OPEN)
  paidAt         DateTime?
  notes          String?
  createdAt      DateTime      @default(now())

  @@unique([subscriptionId, referenceMonth])
}

// ============================================================
// Usuários, permissões e auditoria
// ============================================================

enum Role {
  PLATFORM_OWNER
  COMPANY_ADMIN
  FINANCE
  COLLECTION
  CLIENT
}

model User {
  id               String    @id @default(cuid())
  companyId        String?
  company          Company?  @relation(fields: [companyId], references: [id])
  clientId         String?   @unique
  client           Client?   @relation(fields: [clientId], references: [id])
  name             String
  email            String
  passwordHash     String
  role             Role
  permissionGrants String[]  @default([])
  permissionDenies String[]  @default([])
  active           Boolean   @default(true)
  twoFactorEnabled Boolean   @default(false)
  twoFactorSecret  String? // criptografado
  lastLoginAt      DateTime?
  mustChangePassword Boolean @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  auditLogs           AuditLog[]

  @@unique([companyId, email])
  @@index([email])
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ip        String?
  createdAt DateTime @default(now())
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
}

model RolePermission {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  role        Role
  permissions String[]
  updatedAt   DateTime @updatedAt

  @@unique([companyId, role])
}

model AuditLog {
  id        String   @id @default(cuid())
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  userName  String?
  action    String
  entity    String
  entityId  String?
  before    Json?
  after     Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([entity, entityId])
}

model Counter {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  key       String
  value     Int     @default(0)

  @@unique([companyId, key])
}

// ============================================================
// Arquivos privados
// ============================================================

model StoredFile {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id])
  storageKey   String   @unique
  filename     String
  mimeType     String
  size         Int
  sha256       String
  uploadedById String?
  createdAt    DateTime @default(now())

  clientDocuments ClientDocument[]
  contracts       Contract[]
  payments        Payment[]
}

// ============================================================
// Clientes
// ============================================================

enum PersonType {
  PF
  PJ
}

enum ClientStatus {
  ACTIVE
  BLOCKED
  INACTIVE
}

model Client {
  id           String       @id @default(cuid())
  companyId    String
  company      Company      @relation(fields: [companyId], references: [id])
  personType   PersonType   @default(PF)
  name         String
  document     String // CPF/CNPJ apenas dígitos
  email        String?
  phone        String?
  birthDate    DateTime?    @db.Date
  addressStreet String?
  addressNumber String?
  addressComplement String?
  addressDistrict String?
  addressCity  String?
  addressState String?
  addressZip   String?
  notes        String?
  status       ClientStatus @default(ACTIVE)
  contactPreferences Json   @default("{\"email\":true,\"sms\":true,\"portal\":true}")
  createdById  String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  user           User?
  documents      ClientDocument[]
  loans          Loan[]
  reminders      Reminder[]
  notifications  Notification[]
  serviceRequests ServiceRequest[]
  accessTokens   ClientAccessToken[]
  payments       Payment[]

  @@unique([companyId, document])
  @@index([companyId, name])
}

model ClientDocument {
  id        String     @id @default(cuid())
  companyId String
  company   Company    @relation(fields: [companyId], references: [id])
  clientId  String
  client    Client     @relation(fields: [clientId], references: [id])
  type      String // RG, CPF, COMPROVANTE_RESIDENCIA, COMPROVANTE_RENDA, OUTRO
  fileId    String
  file      StoredFile @relation(fields: [fileId], references: [id])
  createdAt DateTime   @default(now())
}

// ============================================================
// Produtos e empréstimos
// ============================================================

enum CalcMethod {
  PRICE
  SAC
  SIMPLE
}

enum Periodicity {
  MONTHLY
  BIWEEKLY
  WEEKLY
  DAILY
}

enum ChargeMode {
  DEDUCTED // tarifas e tributos descontados do valor liberado
  FINANCED // tarifas e tributos somados ao principal financiado
}

model LoanProduct {
  id                 String      @id @default(cuid())
  companyId          String
  company            Company     @relation(fields: [companyId], references: [id])
  name               String
  calcMethod         CalcMethod  @default(PRICE)
  monthlyRate        Decimal     @db.Decimal(10, 6) // % ao mês, ex: 3.5
  originationFee     Decimal     @default(0) @db.Decimal(12, 2)
  originationFeeRate Decimal     @default(0) @db.Decimal(10, 6) // % sobre o valor
  iofFixedRate       Decimal     @default(0) @db.Decimal(10, 6) // %
  iofDailyRate       Decimal     @default(0) @db.Decimal(10, 6) // % ao dia
  chargeMode         ChargeMode  @default(DEDUCTED)
  lateFineRate       Decimal     @default(2) @db.Decimal(10, 6) // multa %
  lateInterestMonthly Decimal    @default(1) @db.Decimal(10, 6) // mora % ao mês
  legalNotes         String?
  legallyReviewed    Boolean     @default(false)
  active             Boolean     @default(true)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  loans              Loan[]
}

enum LoanStatus {
  DRAFT          // simulação salva / proposta
  UNDER_REVIEW   // em avaliação de crédito
  APPROVED       // aprovado pelo responsável
  REJECTED
  AWAITING_SIGNATURE
  SIGNED         // contrato assinado, aguardando liberação
  ACTIVE         // liberado, em andamento
  PAID           // quitado
  RENEGOTIATED   // substituído por novo empréstimo
  CANCELLED
}

enum CollectionState {
  ACTIVE
  PAUSED
}

model Loan {
  id                  String          @id @default(cuid())
  companyId           String
  company             Company         @relation(fields: [companyId], references: [id])
  clientId            String
  client              Client          @relation(fields: [clientId], references: [id])
  productId           String?
  product             LoanProduct?    @relation(fields: [productId], references: [id])
  number              Int
  status              LoanStatus      @default(DRAFT)

  // condições
  requestedAmount     Decimal         @db.Decimal(14, 2)
  principalAmount     Decimal         @db.Decimal(14, 2) // valor financiado (base dos juros)
  disbursedAmount     Decimal         @db.Decimal(14, 2) // valor efetivamente liberado
  disbursementDate    DateTime        @db.Date
  installmentsCount   Int
  periodicity         Periodicity     @default(MONTHLY)
  firstDueDate        DateTime        @db.Date
  calcMethod          CalcMethod      @default(PRICE)
  monthlyRate         Decimal         @db.Decimal(10, 6)
  chargeMode          ChargeMode      @default(DEDUCTED)
  originationFee      Decimal         @default(0) @db.Decimal(12, 2)
  iofAmount           Decimal         @default(0) @db.Decimal(12, 2)
  iofFixedRate        Decimal         @default(0) @db.Decimal(10, 6)
  iofDailyRate        Decimal         @default(0) @db.Decimal(10, 6)
  lateFineRate        Decimal         @default(2) @db.Decimal(10, 6)
  lateInterestMonthly Decimal         @default(1) @db.Decimal(10, 6)

  // resultados do cálculo (congelados na confirmação)
  installmentAmount   Decimal         @db.Decimal(14, 2) // primeira parcela (SAC varia)
  totalAmount         Decimal         @db.Decimal(14, 2)
  totalInterest       Decimal         @db.Decimal(14, 2)
  totalCharges        Decimal         @db.Decimal(14, 2)
  effectiveMonthlyRate Decimal        @db.Decimal(10, 6)
  effectiveAnnualRate Decimal         @db.Decimal(10, 6)
  cetMonthly          Decimal         @db.Decimal(10, 6)
  cetAnnual           Decimal         @db.Decimal(10, 6)
  roundingRule        String          @default("HALF_UP_2_LAST_ADJUST")
  calcExplanation     String?

  // avaliação e aprovação
  assessmentNotes     String?
  assessmentScore     Int?
  approvedById        String?
  approvedAt          DateTime?
  rejectedReason      String?
  signedAt            DateTime?
  disbursedAt         DateTime?
  paidOffAt           DateTime?
  cancelledAt         DateTime?

  collectionState     CollectionState @default(ACTIVE)
  collectionPauseReason String?

  parentLoanId        String?
  parentLoan          Loan?           @relation("Renegotiation", fields: [parentLoanId], references: [id])
  children            Loan[]          @relation("Renegotiation")

  notes               String?
  createdById         String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  installments   Installment[]
  payments       Payment[]
  contracts      Contract[]
  events         LoanEvent[]
  renegotiationsFrom Renegotiation[] @relation("RenegFrom")
  renegotiationsTo   Renegotiation[] @relation("RenegTo")
  serviceRequests ServiceRequest[]

  @@unique([companyId, number])
  @@index([companyId, status])
  @@index([companyId, clientId])
}

model LoanEvent {
  id        String   @id @default(cuid())
  loanId    String
  loan      Loan     @relation(fields: [loanId], references: [id])
  type      String // CREATED, SUBMITTED, ASSESSED, APPROVED, REJECTED, CONTRACT_GENERATED, SIGNED, DISBURSED, PAID_OFF, RENEGOTIATED, CANCELLED, COLLECTION_PAUSED, COLLECTION_RESUMED
  userId    String?
  userName  String?
  data      Json?
  createdAt DateTime @default(now())

  @@index([loanId, createdAt])
}

// ============================================================
// Parcelas e pagamentos
// ============================================================

enum InstallmentStatus {
  PENDING
  PARTIAL
  PAID
  RENEGOTIATED
  CANCELLED
}

model Installment {
  id                String            @id @default(cuid())
  companyId         String
  company           Company           @relation(fields: [companyId], references: [id])
  loanId            String
  loan              Loan              @relation(fields: [loanId], references: [id])
  number            Int
  dueDate           DateTime          @db.Date
  principalAmount   Decimal           @db.Decimal(14, 2)
  interestAmount    Decimal           @db.Decimal(14, 2)
  originalAmount    Decimal           @db.Decimal(14, 2) // principal + juros
  status            InstallmentStatus @default(PENDING)

  paidPrincipal     Decimal           @default(0) @db.Decimal(14, 2)
  paidInterest      Decimal           @default(0) @db.Decimal(14, 2)
  paidCharges       Decimal           @default(0) @db.Decimal(14, 2)
  discountAmount    Decimal           @default(0) @db.Decimal(14, 2)
  chargesCarried    Decimal           @default(0) @db.Decimal(14, 2) // encargos apurados e ainda não pagos
  fineApplied       Boolean           @default(false)
  lastPaymentAt     DateTime?         @db.Date
  paidAt            DateTime?
  renegotiatedIntoLoanId String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  payments  Payment[]
  charges   Charge[]
  reminders Reminder[]

  @@unique([loanId, number])
  @@index([companyId, dueDate, status])
}

enum PaymentMethod {
  PIX
  BOLETO
  CASH
  TRANSFER
  CARD
  OTHER
}

enum PaymentStatus {
  CONFIRMED
  PENDING_REVIEW // comprovante enviado pelo cliente, aguardando conferência
  REJECTED
  REVERSED
}

enum PaymentSource {
  MANUAL
  PROVIDER
  CLIENT_UPLOAD
  PAYOFF
  RENEGOTIATION
}

model Payment {
  id               String        @id @default(cuid())
  companyId        String
  company          Company       @relation(fields: [companyId], references: [id])
  loanId           String
  loan             Loan          @relation(fields: [loanId], references: [id])
  installmentId    String
  installment      Installment   @relation(fields: [installmentId], references: [id])
  clientId         String
  client           Client        @relation(fields: [clientId], references: [id])
  receiptNumber    Int?
  amount           Decimal       @db.Decimal(14, 2)
  principalPortion Decimal       @default(0) @db.Decimal(14, 2)
  interestPortion  Decimal       @default(0) @db.Decimal(14, 2)
  chargesPortion   Decimal       @default(0) @db.Decimal(14, 2)
  discountAmount   Decimal       @default(0) @db.Decimal(14, 2)
  method           PaymentMethod @default(OTHER)
  status           PaymentStatus @default(CONFIRMED)
  source           PaymentSource @default(MANUAL)
  paidAt           DateTime      @db.Date
  receivedById     String?
  receivedByName   String?
  proofFileId      String?
  proofFile        StoredFile?   @relation(fields: [proofFileId], references: [id])
  chargeId         String?
  charge           Charge?       @relation(fields: [chargeId], references: [id])
  notes            String?
  reviewedById     String?
  reviewedAt       DateTime?
  reversedAt       DateTime?
  reversedById     String?
  reversalReason   String?
  createdAt        DateTime      @default(now())

  @@index([companyId, paidAt])
  @@index([installmentId])
}

// ============================================================
// Renegociação
// ============================================================

model Renegotiation {
  id             String   @id @default(cuid())
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id])
  originalLoanId String
  originalLoan   Loan     @relation("RenegFrom", fields: [originalLoanId], references: [id])
  newLoanId      String
  newLoan        Loan     @relation("RenegTo", fields: [newLoanId], references: [id])
  installmentIds String[]
  balanceBefore  Decimal  @db.Decimal(14, 2)
  discount       Decimal  @default(0) @db.Decimal(14, 2)
  balanceRenegotiated Decimal @db.Decimal(14, 2)
  notes          String?
  createdById    String?
  createdAt      DateTime @default(now())
}

// ============================================================
// Contratos
// ============================================================

enum TemplateStatus {
  DRAFT
  APPROVED
  ARCHIVED
}

model ContractTemplate {
  id           String         @id @default(cuid())
  companyId    String
  company      Company        @relation(fields: [companyId], references: [id])
  name         String
  version      Int            @default(1)
  content      String // texto com marcadores {{...}}
  status       TemplateStatus @default(DRAFT)
  approvedById String?
  approvedAt   DateTime?
  legalReviewNotes String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  contracts    Contract[]

  @@index([companyId, name])
}

enum ContractStatus {
  DRAFT
  IN_REVIEW
  AWAITING_SIGNATURE
  SIGNED
  CANCELLED
}

model Contract {
  id                 String         @id @default(cuid())
  companyId          String
  company            Company        @relation(fields: [companyId], references: [id])
  loanId             String
  loan               Loan           @relation(fields: [loanId], references: [id])
  templateId         String?
  template           ContractTemplate? @relation(fields: [templateId], references: [id])
  templateVersion    Int?
  version            Int            @default(1)
  kind               String         @default("CONTRACT") // CONTRACT | ADDENDUM
  status             ContractStatus @default(DRAFT)
  renderedContent    String // texto final (congelado)
  fileId             String?
  file               StoredFile?    @relation(fields: [fileId], references: [id])
  sha256             String?
  signatureProvider  String?
  signatureExternalId String?
  signatureEvidence  Json?
  signedAt           DateTime?
  cancelledAt        DateTime?
  cancelReason       String?
  parentContractId   String?
  parentContract     Contract?      @relation("Addendum", fields: [parentContractId], references: [id])
  addenda            Contract[]     @relation("Addendum")
  createdById        String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  signers            ContractSigner[]

  @@index([companyId, status])
}

model ContractSigner {
  id         String    @id @default(cuid())
  contractId String
  contract   Contract  @relation(fields: [contractId], references: [id])
  name       String
  document   String?
  email      String?
  role       String // BORROWER | LENDER | WITNESS
  signedAt   DateTime?
  ip         String?
  evidence   Json?
}

// ============================================================
// Cobranças automáticas
// ============================================================

model CollectionSettings {
  id                 String   @id @default(cuid())
  companyId          String   @unique
  company            Company  @relation(fields: [companyId], references: [id])
  enabled            Boolean  @default(false)
  timezone           String   @default("America/Sao_Paulo")
  sendHourStart      Int      @default(9)
  sendHourEnd        Int      @default(18)
  sendDays           Int[]    @default([1, 2, 3, 4, 5]) // 0=domingo
  maxPerClientPerDay Int      @default(2)
  steps              Json     @default("[{\"offsetDays\":-3,\"channels\":[\"EMAIL\",\"PORTAL\"]},{\"offsetDays\":0,\"channels\":[\"EMAIL\",\"SMS\",\"PORTAL\"]},{\"offsetDays\":3,\"channels\":[\"EMAIL\",\"SMS\",\"PORTAL\"]},{\"offsetDays\":7,\"channels\":[\"EMAIL\",\"SMS\",\"PORTAL\"]}]")
  updatedAt          DateTime @updatedAt
}

enum Channel {
  EMAIL
  SMS
  PORTAL
}

model MessageTemplate {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  key       String // BEFORE_DUE, DUE_TODAY, OVERDUE, RECEIPT, PASSWORD_RESET, ...
  channel   Channel
  subject   String?
  body      String
  updatedAt DateTime @updatedAt

  @@unique([companyId, key, channel])
}

enum ReminderStatus {
  SCHEDULED
  SENT
  FAILED
  CANCELLED
  SKIPPED
}

model Reminder {
  id                String         @id @default(cuid())
  companyId         String
  company           Company        @relation(fields: [companyId], references: [id])
  installmentId     String
  installment       Installment    @relation(fields: [installmentId], references: [id])
  clientId          String
  client            Client         @relation(fields: [clientId], references: [id])
  offsetDays        Int
  channel           Channel
  dedupeKey         String         @unique // installmentId:offset:channel
  scheduledFor      DateTime
  status            ReminderStatus @default(SCHEDULED)
  attempts          Int            @default(0)
  sentAt            DateTime?
  providerMessageId String?
  lastError         String?
  cancelReason      String?
  renderedSubject   String?
  renderedBody      String?
  manual            Boolean        @default(false)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  attemptsLog       ReminderAttempt[]

  @@index([companyId, status, scheduledFor])
  @@index([clientId, sentAt])
}

model ReminderAttempt {
  id         String   @id @default(cuid())
  reminderId String
  reminder   Reminder @relation(fields: [reminderId], references: [id])
  number     Int
  status     String // SENT | FAILED | DELIVERED | BOUNCED
  response   String?
  createdAt  DateTime @default(now())
}

model Notification {
  id        String    @id @default(cuid())
  companyId String
  company   Company   @relation(fields: [companyId], references: [id])
  clientId  String
  client    Client    @relation(fields: [clientId], references: [id])
  title     String
  body      String
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([clientId, readAt])
}

model ClientAccessToken {
  id        String    @id @default(cuid())
  companyId String
  company   Company   @relation(fields: [companyId], references: [id])
  clientId  String
  client    Client    @relation(fields: [clientId], references: [id])
  tokenHash String    @unique
  purpose   String    @default("PORTAL_LINK")
  target    String?
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

// ============================================================
// Recebimentos via provedor (Pix / boleto) e webhooks
// ============================================================

enum ChargeType {
  PIX
  BOLETO
}

enum ChargeStatus {
  PENDING
  PAID
  EXPIRED
  CANCELLED
  FAILED
}

model Charge {
  id            String       @id @default(cuid())
  companyId     String
  company       Company      @relation(fields: [companyId], references: [id])
  installmentId String
  installment   Installment  @relation(fields: [installmentId], references: [id])
  provider      String
  externalId    String
  type          ChargeType
  amount        Decimal      @db.Decimal(14, 2)
  feeAmount     Decimal?     @db.Decimal(14, 2)
  netAmount     Decimal?     @db.Decimal(14, 2)
  status        ChargeStatus @default(PENDING)
  payload       Json? // qr code, copia e cola, linha digitável, url
  expiresAt     DateTime?
  paidAt        DateTime?
  lastError     String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  payments      Payment[]

  @@unique([provider, externalId])
  @@index([companyId, status])
}

model WebhookEvent {
  id              String    @id @default(cuid())
  provider        String
  externalEventId String
  eventType       String
  payload         Json
  status          String    @default("RECEIVED") // RECEIVED | PROCESSED | IGNORED | FAILED
  error           String?
  processedAt     DateTime?
  createdAt       DateTime  @default(now())

  @@unique([provider, externalEventId])
}

model IntegrationIssue {
  id         String    @id @default(cuid())
  companyId  String
  company    Company   @relation(fields: [companyId], references: [id])
  kind       String // PAYMENT_WEBHOOK | CHARGE_CREATE | SIGNATURE | EMAIL | SMS
  reference  String?
  message    String
  details    Json?
  resolvedAt DateTime?
  resolvedById String?
  createdAt  DateTime  @default(now())

  @@index([companyId, resolvedAt])
}

// ============================================================
// Portal do cliente — atendimento
// ============================================================

model ServiceRequest {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id])
  loanId      String?
  loan        Loan?    @relation(fields: [loanId], references: [id])
  type        String // SUPPORT | RENEGOTIATION | DISPUTE
  message     String
  status      String   @default("OPEN") // OPEN | IN_PROGRESS | CLOSED
  response    String?
  handledById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============================================================
// Relatórios e despesas
// ============================================================

model Expense {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  date        DateTime @db.Date
  description String
  category    String   @default("GERAL")
  amount      Decimal  @db.Decimal(14, 2)
  createdById String?
  createdAt   DateTime @default(now())

  @@index([companyId, date])
}

model MonthlyReport {
  id             String   @id @default(cuid())
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id])
  referenceMonth String // AAAA-MM
  version        Int      @default(1)
  referenceDate  DateTime // data/hora de referência do fechamento
  generatedById  String?
  automatic      Boolean  @default(false)
  data           Json
  createdAt      DateTime @default(now())

  @@unique([companyId, referenceMonth, version])
}
